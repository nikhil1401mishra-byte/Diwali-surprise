# =========================================================================
# A LITTLE DIWALI SURPRISE — FROM NIKHIL
# Environment Variables Configuration
# =========================================================================

# 1. Supabase Project Settings
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Server-Only Service Role Key (NEVER expose to client code)
# Get this from Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 3. Authorized Admin Email (Only this email can access /admin)
ADMIN_EMAIL=nikhil@example.com

